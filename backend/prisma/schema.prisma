// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  first_name     String?
  last_name      String?
  middle_initial String?
  password  String
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now())

  // Reset Password Fields
  resetToken     String?
  resetOtp       String?
  resetExpiresAt DateTime?

  patient   Patient?
  doctor    Doctor?
}

model Activity {
  id        Int      @id @default(autoincrement())
  type      String   // e.g., "USER_CREATED", "DOCTOR_APPROVED", "DOCTOR_REJECTED"
  message   String
  email     String?
  createdAt DateTime @default(now())
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

model Patient {
  id        Int      @id @default(autoincrement())
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?     @unique
  first_name     String
  last_name      String
  middle_initial String?
  age       Int
  contact   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessments Assessment[]
  alerts      Alert[]
  notifications Notification[]
  wellnessChecks WellnessCheck[]
  accessCodes AccessCode[]
}

model AccessCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  patient     Patient  @relation(fields: [patientId], references: [id])
  patientId   Int
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  usedById    Int?     // Doctor ID who used it
  usedAt      DateTime?
}

model WellnessCheck {
  id                 Int      @id @default(autoincrement())
  patient            Patient  @relation(fields: [patientId], references: [id])
  patientId          Int
  sleep_hours        Float
  water_intake       Float?
  diet_quality       String?
  stress_level       String?
  supplements_taken  Boolean?
  mood               String?
  tips               Json?
  createdAt          DateTime @default(now())
}

model Doctor {
  id        Int      @id @default(autoincrement())
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?     @unique
  first_name     String
  last_name      String
  middle_initial String?
  status         String   @default("PENDING")
  id_card_url    String?
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessments Assessment[]
  alerts      Alert[] @relation("AlertAssignee")
  notifications Notification[]
}

model Assessment {
  id                 Int      @id @default(autoincrement())
  patient            Patient  @relation(fields: [patientId], references: [id])
  patientId          Int
  doctor             Doctor?  @relation(fields: [doctorId], references: [id])
  doctorId           Int?
  version            Int
  physiological_data Json
  model_version      String
  risk_score         Float
  risk_label         String
  raw_probabilities  Json?
  explanations       Json?
  possible_maternal_risks Json?
  recommendations         Json?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  alerts Alert[]

  @@unique([patientId, version])
}

model Alert {
  id             Int            @id @default(autoincrement())
  assessment     Assessment     @relation(fields: [assessmentId], references: [id])
  assessmentId   Int
  patient        Patient        @relation(fields: [patientId], references: [id])
  patientId      Int
  assignee       Doctor?        @relation("AlertAssignee", fields: [assigneeId], references: [id])
  assigneeId     Int?
  type           AlertType
  severity       AlertSeverity
  status         AlertStatus    @default(OPEN)
  message        String
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?

  notifications Notification[]
}

model Notification {
  id        Int        @id @default(autoincrement())
  alert     Alert?     @relation(fields: [alertId], references: [id])
  alertId   Int?
  patient   Patient?   @relation(fields: [patientId], references: [id])
  patientId Int?
  doctor    Doctor?    @relation(fields: [doctorId], references: [id])
  doctorId  Int?
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  is_read   Boolean   @default(false)
  createdAt DateTime  @default(now())
  readAt    DateTime?
}

enum AlertType {
  MATERNAL_RISK
  OTHER
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum NotificationChannel {
  IN_APP
}
